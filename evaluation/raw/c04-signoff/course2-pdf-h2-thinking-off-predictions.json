    {
      "id": "kp_f0cf9c0287e0a74cb576651e2f2ba59a",
      "name": "程序与进程的区别",
      "type": "concept",
      "source": "ai",
      "definition": "程序是静态的指令集合，进程则是动态的执行实体；同一个程序运行两次，就产生两个不同的进程。"
    },
    {
      "id": "kp_f1a8bdeb8029c048001619ccbda42ae0",
      "name": "优先级调度算法",
      "type": "method",
      "source": "ai",
      "definition": "为每个进程设置优先级，总是选择优先级最高的就绪进程的调度算法。"
    },
    {
      "id": "kp_f68b54c8479e98383905c57e0427cb0b",
      "name": "进程与线程的比较",
      "type": "concept",
      "source": "ai",
      "definition": "进程是资源分配的基本单位，线程是处理机调度的基本单位；同一进程中的线程切换不会引起进程切换，不同进程中的线程切换则会引起进程切换。"
    },
    {
      "id": "kp_f70b86e6f975b45800ddb9b519acde40",
      "name": "线程切换与进程切换",
      "type": "theorem",
      "source": "ai",
      "definition": "同一进程中的线程切换不会引起进程切换；不同进程中的线程切换则会引起进程切换。"
    }
  ],
