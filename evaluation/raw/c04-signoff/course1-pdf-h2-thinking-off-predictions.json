    {
      "id": "kp_c35a8167e4e3a221af9ec3722bd77b1a",
      "name": "递归转非递归",
      "type": "method",
      "source": "ai",
      "definition": "借助显式的栈保存待处理的状态，把递归算法改写为非递归算法。"
    },
    {
      "id": "kp_c72f7254c8751f3637a9913c3e7b2e33",
      "name": "出栈序列判断",
      "type": "example",
      "source": "ai",
      "definition": "元素 1、2、3 依次入栈，判断 3 1 2 是否为合法出栈序列。3 最先出栈，说明 1 和 2 此时都在栈中且 2 在 1 之上，下一个出栈的只能是 2 而不能是 1，所以 3 1 2 不合法。按性质 3.1，取 i = 1、j = 2、k = 3，有 p2 = 1 < p3 = 2 < p1 = 3，同样得出不合法的结论。全部 5 个合法序列为 123、132、213、231、321，这与定理 3.1 的计数结果一致。"
    },
    {
      "id": "kp_cbeb62ec7993792ab63a865017a5c1e1",
      "name": "栈的典型应用场景",
      "type": "example",
      "source": "ai",
      "definition": "撤销操作、回溯搜索和函数调用等需要暂存后逆序处理的场合，适合用栈。"
    },
    {
      "id": "kp_cd4d29275fc42726c43fbb03632f52df",
      "name": "中缀表达式",
      "type": "concept",
      "source": "ai",
      "definition": "把运算符放在两个操作数中间的算术表达式，需要依靠运算符优先级和括号才能确定计算次序。"
    },
    {
      "id": "kp_cee35f19af5d6872df6a8f8c64719fbc",
      "name": "队尾",
      "type": "concept",
      "source": "ai",
      "definition": "队列中允许插入元素的一端称为队尾。"
    },
    {
      "id": "kp_d7d170ae4850cac4842f4ffa2f892666",
      "name": "队列的应用",
      "type": "example",
      "source": "ai",
      "definition": "队列适合处理需要按到达次序服务的问题，例如操作系统中的作业调度、打印机缓冲区以及图的广度优先遍历。"
    },
    {
      "id": "kp_d7d28db660af4c9950542b72c39db637",
      "name": "栈的典型应用",
      "type": "example",
      "source": "ai",
      "definition": "栈的典型应用包括括号匹配、表达式求值和递归。"
    },
    {
      "id": "kp_d8e5e75c830e3437a67bb91e037cc343",
      "name": "双端队列与栈和队列的关系",
      "type": "theorem",
      "source": "ai",
      "definition": "双端队列与栈、队列都密切相关。"
    },
    {
      "id": "kp_d8fb0a7151b8e8fc393bc51592013ae3",
      "name": "队列的基本操作",
      "type": "method",
      "source": "ai",
      "definition": "队列的基本操作包括初始化、判空、入队、出队和读队头元素；入队是在队尾插入元素，出队是删除队头元素。"
    },
    {
      "id": "kp_daaf3c6f3e1b627df3f9bcd075892314",
      "name": "平均等待时间",
      "type": "formula",
      "source": "ai",
      "definition": "平均等待时间为各顾客等待时间之和除以顾客人数，例中为 (0 + 2 + 4) / 3 = 2 分钟。"
    },
    {
      "id": "kp_dafda530422823ca40f9cda3927edfd4",
      "name": "阶乘的递归计算",
      "type": "example",
      "source": "ai",
      "definition": "计算 3! 时，fact(3) 调用 fact(2)，fact(2) 调用 fact(1)，递归工作栈中依次压入三层记录；fact(1) 返回 1 后逐层弹出，依次得到 fact(2) = 2 和 fact(3) = 6。"
    },
    {
      "id": "kp_e7bf2adb142018d5cf9e316395bc825c",
      "name": "链栈",
      "type": "concept",
      "source": "ai",
      "definition": "采用链式存储的栈，通常用不带头结点的单链表实现，所有操作都在表头进行，表头指针即栈顶指针。"
    },
    {
      "id": "kp_f07c4ded3e72384362e469dc7571fca9",
      "name": "入栈",
      "type": "method",
      "source": "ai",
      "definition": "入栈（Push）是在栈顶插入一个新元素，使之成为新的栈顶。"
    },
    {
      "id": "kp_f2b7ae008a9f1c05ccbb60c815df8b46",
      "name": "银行排队模拟",
      "type": "example",
      "source": "ai",
      "definition": "银行只有一个窗口，顾客按到达时间依次入队，窗口空闲时让队头顾客出队办理业务；顾客 A、B、C 分别在第 0、1、2 分钟到达，每人办理 3 分钟，平均等待时间为 2 分钟，体现队列先进先出的服务次序。"
    },
    {
      "id": "kp_f5ab6dc01f8ed4923a44715509ec59e2",
      "name": "出栈",
      "type": "method",
      "source": "ai",
      "definition": "出栈（Pop）是删除栈顶元素并返回它。"
    },
    {
      "id": "kp_f70ab7008855f26c7c08fcee83019786",
      "name": "后缀表达式",
      "type": "concept",
      "source": "ai",
      "definition": "把运算符放在两个操作数之后的写法，也叫逆波兰式，不含括号，计算次序完全由运算符出现的位置决定，适合计算机处理。"
    }
  ],
