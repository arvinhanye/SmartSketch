    },
    {
      "id": "kp_0e0e587d3430e3927664618f0e58bb7f",
      "name": "后进先出",
      "type": "theorem",
      "source": "ai",
      "definition": "栈的操作特性：由于最后进入的元素最先被删除，概括为后进先出（Last In First Out，LIFO）。"
    },
    {
      "id": "kp_0f77ef8a4c9a3e0f98cd24efbd526827",
      "name": "栈与队列的插入删除位置差异",
      "type": "concept",
      "source": "ai",
      "definition": "栈的插入和删除都在同一端完成，因此最后到达的元素最先被处理；队列的插入和删除分别在两端完成，因此最早到达的元素最先被处理。"
    },
    {
      "id": "kp_1043c9a9c6cd3a0d2fa973fae957d358",
      "name": "双端队列退化为栈",
      "type": "theorem",
      "source": "ai",
      "definition": "如果限制双端队列只在一端插入和删除，它就退化为栈。"
    },
    {
      "id": "kp_174d21b2b08cb3742c572c48f8061334",
      "name": "出栈序列",
      "type": "concept",
      "source": "ai",
      "definition": "设有 n 个元素按 1, 2, …, n 的顺序依次入栈，入栈与出栈可以任意交错，于是可能得到多种不同的出栈序列。"
    },
    {
