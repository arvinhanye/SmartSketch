  "boundary": "PROFILE instrumentation, not fixed-8s performance acceptance; two courses in one disposable Neo4j",
  "probe_source": "\"\"\"Diagnostic only: PROFILE each statement once in the disposable benchmark database.\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nimport time\nfrom unittest.mock import patch\n\nfrom app.repositories.persist_transport import PersistTransport\nfrom evaluation import measure_extraction_perf as measure\n\nrecords = []\nlabels = measure.query_labels()\n\ndef profile_run(self, query, parameters):\n    self._require_open()\n    async def execute():\n        started = time.monotonic()\n        result = await self._tx.run('PROFILE ' + query, dict(parameters))\n        rows = await result.data()\n        summary = await result.consume()\n        fingerprint = hashlib.sha256(' '.join(query.split()).encode()).hexdigest()\n        records.append({\n            'query_label': labels.get(fingerprint), 'query_sha256': fingerprint,\n            'wall_seconds': time.monotonic() - started,\n            'available_after_ms': summary.result_available_after,\n            'consumed_after_ms': summary.result_consumed_after,\n            'profile': summary.profile,\n        })\n        return rows\n    rows = self._runner.run(self._bounded('run', self.deadline, execute))\n    self._check()\n    return rows\n\nout = Path('.demo/extraction-perf/profile')\nout.mkdir(exist_ok=True)\ntry:\n    with patch.object(PersistTransport, 'run', profile_run):\n        status = measure.main(['--out-dir', str(out), '--delay-seconds', '0', '--concurrency', '8',\n            '--repeats', '2', '--concurrent-work-note',\n            'DIAGNOSTIC PROFILE adds instrumentation; default8 full/basic tests and other local Docker workloads running'])\nfinally:\n    (out / 'query-profiles.json').write_text(json.dumps(records, ensure_ascii=False, indent=2) + '\\n')\nraise SystemExit(status)\n",
