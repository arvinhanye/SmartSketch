    },
    {
      "id": "kp_bd158804ebaba7ca6ec5bfb17e4279dd",
      "name": "循环队列指针后移公式",
      "type": "formula",
      "source": "ai",
      "definition": "循环队列中指针后移的公式为 rear = (rear + 1) % MaxSize，front 的后移方式相同，用于实现指针回绕。"
    },
    {
      "id": "kp_beec8b5aaebfb67c7cfc410f0cba2d81",
      "name": "上溢",
      "type": "concept",
      "source": "ai",
      "definition": "当栈中已有 MaxSize 个元素时再执行入栈，就会发生上溢；上溢说明预分配的空间不足，是顺序栈的主要缺点。"
    },
    {
      "id": "kp_bfe85f7faa118b63a66766892233dc68",
      "name": "链队列出队",
      "type": "method",
