    },
    {
      "id": "kp_db20d57d5a6d4b2947ffe5fe6aecb25c",
      "name": "引入线程的目的",
      "type": "theorem",
      "source": "ai",
      "definition": "引入线程是为了减小程序并发执行时的时空开销。"
    },
    {
      "id": "kp_e1d324ada78c54eb0e76f488b5f19dd8",
      "name": "内核级线程",
      "type": "concept",
      "source": "ai",
      "definition": "由操作系统内核管理的线程；一个线程阻塞时内核可以调度同一进程的其他线程，代价是线程切换需要进入内核态。"
    },
    {
      "id": "kp_eb81f8e83a2c11025aac6c93f18af13b",
      "name": "调度算法衡量指标",
      "type": "concept",
      "source": "ai",
      "definition": "衡量调度算法的指标包括处理机利用率、系统吞吐量、周转时间、等待时间和响应时间。"
    },
    {
      "id": "kp_f3a70a8777e8b86c4edb9787e1f36062",
      "name": "进程互斥",
      "type": "concept",
      "source": "ai",
      "definition": "当一个进程访问某种资源时，其他进程不能同时访问。"
    },
    {
      "id": "kp_f7c704975d030f229e8dfa3dfc4230b9",
      "name": "高级调度",
      "type": "concept",
      "source": "ai",
      "definition": "决定把哪些作业调入内存的调度层次。"
    },
    {
      "id": "kp_feefcaeb895ff0414f9ae502a6e9147e",
      "name": "进程是资源分配的基本单位",
      "type": "concept",
      "source": "ai",
      "definition": "进程是系统进行资源分配的基本单位，拥有独立的资源。"
    }
  ],
