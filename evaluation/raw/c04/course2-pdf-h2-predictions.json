    {
      "id": "kp_dc74d3c9f9d99cc86b0fbd1feef4fdf2",
      "name": "信箱",
      "type": "concept",
      "source": "ai",
      "definition": "消息传递中消息可以经过的中间实体，称为信箱。"
    },
    {
      "id": "kp_de781981793f45e2d38e46d2fd15e860",
      "name": "进程互斥",
      "type": "concept",
      "source": "ai",
      "definition": "当一个进程访问某种资源时，其他进程不能同时访问。"
    },
    {
      "id": "kp_e00aadfc0336c96224e1a9dbf249dfaf",
      "name": "低级调度",
      "type": "concept",
      "source": "ai",
      "definition": "决定把处理机分配给哪个就绪进程的调度。"
    },
    {
      "id": "kp_e0fcbad25517fb6377f5ab895ed9fd2a",
      "name": "多线程模型",
      "type": "concept",
      "source": "ai",
      "definition": "把用户级线程映射到内核级线程的方式，包括多对一模型、一对一模型和多对多模型。"
    },
    {
      "id": "kp_e67bedc236742603a923ce72f82884fc",
      "name": "线程是处理机调度的基本单位",
      "type": "concept",
      "source": "ai",
      "definition": "线程是处理机调度的基本单位，即处理机的调度以线程为单位。"
    },
    {
      "id": "kp_ea1c440ca9d0933083c8563de4b26bc8",
      "name": "临界资源",
      "type": "concept",
      "source": "ai",
      "definition": "一次只允许一个进程使用的资源。"
    },
    {
      "id": "kp_ea72a650d89f68eb999e704ff550bbf8",
      "name": "线程切换与进程切换的关系",
      "type": "theorem",
      "source": "ai",
      "definition": "同一进程中的线程切换不会引起进程切换；不同进程中的线程切换则会引起进程切换。"
    },
    {
      "id": "kp_f437b08ce29385b20648640f52aa7d76",
      "name": "终止态",
      "type": "concept",
      "source": "ai",
      "definition": "表示进程已经结束的状态。"
    },
    {
      "id": "kp_f440e3b0c6cfd46826fa92aa37c96444",
      "name": "阻塞态",
      "type": "concept",
      "source": "ai",
      "definition": "进程因等待某一事件（例如等待输入输出完成）而暂停执行的状态。"
    },
    {
      "id": "kp_f852e6411195f30c03d6a8c421289561",
      "name": "进程同步",
      "type": "concept",
      "source": "ai",
      "definition": "多个相互合作的进程按照一定的先后次序执行。"
    }
  ],
