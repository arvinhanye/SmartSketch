# 复制为 .env 后填写本机值。仅放变量名与无敏感占位值，真实密钥只留在本机。

# 应用运行
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173

# 本地落盘：原始资料与 SQLite 都放在已被 .gitignore 忽略的 storage/ 下
STORAGE_DIR=./storage
SQLITE_URL=sqlite:///./storage/smartsketch.sqlite3

# Neo4j 连接（供应用使用）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-locally
NEO4J_DATABASE=neo4j

# Neo4j 容器（仅供 docker-compose.yml 插值，应用不读）
NEO4J_IMAGE_TAG=5.26-community
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512M

# 主用大模型（OpenAI 兼容）
LLM_BASE_URL=
LLM_API_KEY=
LLM_EXTRACTION_MODEL=
LLM_CHAT_MODEL=

# 备用大模型：主模型不可用或限流时切换，可与主模型来自不同供应商
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_EXTRACTION_MODEL=
LLM_FALLBACK_CHAT_MODEL=

# 调用约束：超时与并发上限（并发以信号量控制，适配供应商限流）
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=2

# 向量模型：与对话模型独立选型，可能是另一个供应商与另一套凭据
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
