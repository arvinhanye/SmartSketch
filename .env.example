# 复制为 .env 后填写本机值。仅放变量名与无敏感占位值，真实密钥只留在本机。
# 每个变量的类型、约束与签收状态见 docs/integrations.md「运行时环境变量」；取值非法时进程拒绝启动。

# 应用运行
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173

# 存储：相对 SQLite 路径按进程工作目录解析；API 与 worker 从同一目录启动
SQLITE_URL=sqlite:///./storage/smartsketch.sqlite3
# 原始课程资料落盘根目录（已被 .gitignore 忽略，目录内是真实资料，不得提交）；API 与 worker 须指向同一目录
STORAGE_DIR=./storage
# 上传单文件上限（字节，D-11：50 MiB），超过即 413 FILE_TOO_LARGE
UPLOAD_MAX_BYTES=52428800
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-locally
# 本地 Neo4j 容器（docker-compose.yml，F01）：以下为 compose 的缺省值，不是应用设置；需要改时去掉注释
# NEO4J_IMAGE_TAG=5.26-community
# NEO4J_BOLT_PORT=7687
# NEO4J_HTTP_PORT=7474
# NEO4J_HEAP_MAX=1G
# NEO4J_PAGECACHE=512M

# 模型模式：fake 不联网、输出确定，开发与测试用；APP_ENV=production 时禁止任何 fake
LLM_MODE=fake
EMBEDDING_MODE=fake

# 主用大模型（OpenAI 兼容）：LLM_MODE=live 时四项必填；DeepSeek V4.1 Flash（D-02a，ADR-027）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_EXTRACTION_MODEL=deepseek-flash
LLM_CHAT_MODEL=deepseek-flash

# 备用大模型：四项全空＝不配备用，全填＝启用；只填一部分拒绝启动
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_EXTRACTION_MODEL=
LLM_FALLBACK_CHAT_MODEL=

# 调用约束（占位值，待 D-02e 签收）
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_CHAT_FIRST_TOKEN_TIMEOUT_SECONDS=5
LLM_CHAT_TIMEOUT_SECONDS=15
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_OPEN_SECONDS=30

# 预算：按 token 计的软上限，0 表示不发任何请求，没有「不限」写法（占位值，待 D-02d 签收）
LLM_TASK_TOKEN_BUDGET=500000
LLM_DAILY_TOKEN_BUDGET=5000000

# 向量模型：与对话模型独立选型；模型或维度一变即是新向量空间，须重新向量化（待 D-02c 签收）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

# 任务处理（ADR-010 / ADR-011 已签收的默认值）
TASK_MAX_FAILED_CHUNK_RATIO=0.2
WORKER_PROCESSES=1
TASK_LEASE_SECONDS=60
TASK_MAX_ATTEMPTS=3
TASK_CHUNK_MAX_ATTEMPTS=2
TASK_ARTIFACT_RETENTION_DAYS=7

# 发布与课程写锁（ADR-012）
PUBLISH_LEASE_SECONDS=60
COURSE_LOCK_WAIT_SECONDS=5

# 本地账号登录（ADR-013、specs/identity-access.md §2.1）：API 服务入口缺少签名密钥或短于 32 字节即拒绝启动，不回退默认密钥
# 本机生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800
# 演示账号种子口令（C14 种子脚本读取，不是 API 设置；未设置时种子脚本非 0 退出）
# SEED_DEMO_PASSWORD=

# 学习推荐权重（ADR-014 修订 1 已签收）：四项成组，都不设或都为空时用 S2 缺省值；只设一部分、非法或和不为 1 时拒绝启动
RECOMMEND_WEIGHT_UNLOCK=0.35
RECOMMEND_WEIGHT_IMPORTANCE=0.25
RECOMMEND_WEIGHT_CHAPTER=0.20
RECOMMEND_WEIGHT_EASE=0.20
