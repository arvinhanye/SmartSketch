{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartsketch.local/contracts/v1/ChatEvent.schema.json",
  "title": "ChatEvent",
  "$ref": "#/$defs/ChatEvent",
  "$defs": {
    "ChatAnswered": {
      "type": "object",
      "description": "有依据的回答。**至少一条引用**，每条引用必须可定位。",
      "required": [
        "status",
        "answer",
        "citations",
        "graph_version",
        "request_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "answered"
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Citation"
          }
        },
        "related_kp_ids": {
          "type": "array",
          "description": "「涉及的知识点」标签，点击跳转图谱并高亮",
          "items": {
            "type": "string"
          }
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "graph_version": {
          "type": "integer",
          "minimum": 1,
          "description": "本请求绑定的发布版本号（P2 读一次发布指针）；请求途中发布或回滚不影响本请求（Q9）"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "description": "P2 生成的请求 ID（ULID），与日志、`model_calls` 及错误 `details.request_id` 对应"
        }
      }
    },
    "ChatDeltaEvent": {
      "type": "object",
      "description": "正文增量。**delta 阶段的正文是临时态**：其中出现的引用编号可能在\n引用校验后被剔除，前端不得在此阶段渲染可点击引用（events.v1.md §3）。\n",
      "required": [
        "event",
        "delta"
      ],
      "properties": {
        "event": {
          "type": "string",
          "const": "delta"
        },
        "delta": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ChatDoneEvent": {
      "type": "object",
      "description": "终态事件，恰好一条、恒为末条，**携带最终正文**（`specs/grounded-qa.md` Q4、Q6）。\n`final.status = answered` 时，`final.answer` 与已下发全部 delta 的逐字拼接完全相等（不变式 I1），\n前端以 `final.answer` 为准显示并让引用标记变为可点击；两者不一致时仍显示 `final.answer` 并上报异常。\n`final.status = not_covered` 时撤回已显示的临时正文，改为显示 `final.answer`（服务端固定模板）。\n",
      "required": [
        "event",
        "final"
      ],
      "properties": {
        "event": {
          "type": "string",
          "const": "done"
        },
        "final": {
          "$ref": "#/$defs/ChatResponse"
        }
      }
    },
    "ChatError": {
      "description": "问答开流后（P2 之后）的错误，按 `code` 分两支（`specs/grounded-qa.md` Q5 的 O7～O13），码为闭集：\n`LLM_UNAVAILABLE` 必带 `details.reason`；`BUDGET_EXCEEDED`、`STORAGE_UNAVAILABLE`、`INTERNAL_ERROR` 不带 `reason`。\n两支都必带 `details.request_id`。`message` 是固定用户文案，不含模型输出、堆栈、密钥或原文。\n",
      "oneOf": [
        {
          "$ref": "#/$defs/ChatLlmUnavailableError"
        },
        {
          "$ref": "#/$defs/ChatServiceError"
        }
      ],
      "discriminator": {
        "propertyName": "code",
        "mapping": {
          "LLM_UNAVAILABLE": "#/components/schemas/ChatLlmUnavailableError",
          "BUDGET_EXCEEDED": "#/components/schemas/ChatServiceError",
          "STORAGE_UNAVAILABLE": "#/components/schemas/ChatServiceError",
          "INTERNAL_ERROR": "#/components/schemas/ChatServiceError"
        }
      }
    },
    "ChatErrorDetails": {
      "type": "object",
      "description": "开流后错误的公共细节，闭合对象；`reason` 只属于 `LLM_UNAVAILABLE`。",
      "required": [
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ChatErrorEvent": {
      "type": "object",
      "description": "生成中断的异常终止（Q5 的 O7～O13）。与 done 互斥、恰好一条、恒为末条，发送后关闭连接。\n客户端收到后清除已显示的临时正文（Q6）。\n",
      "required": [
        "event",
        "error"
      ],
      "properties": {
        "event": {
          "type": "string",
          "const": "error"
        },
        "error": {
          "$ref": "#/$defs/ChatError"
        }
      }
    },
    "ChatEvent": {
      "description": "单条问答 SSE 事件的 data 载荷。**每种事件有独立 schema 且 required 非空**：\n原先的宽松对象允许 `{}` 通过校验，且文档里的 `answer` 字段在 schema 中并不存在\n（codex 审查 R04）。事件名、顺序与终止语义见 `events.v1.md` §3。\n",
      "oneOf": [
        {
          "$ref": "#/$defs/ChatMetaEvent"
        },
        {
          "$ref": "#/$defs/ChatDeltaEvent"
        },
        {
          "$ref": "#/$defs/ChatDoneEvent"
        },
        {
          "$ref": "#/$defs/ChatErrorEvent"
        }
      ],
      "discriminator": {
        "propertyName": "event",
        "mapping": {
          "meta": "#/components/schemas/ChatMetaEvent",
          "delta": "#/components/schemas/ChatDeltaEvent",
          "done": "#/components/schemas/ChatDoneEvent",
          "error": "#/components/schemas/ChatErrorEvent"
        }
      }
    },
    "ChatLlmUnavailableDetails": {
      "type": "object",
      "description": "开流后 `LLM_UNAVAILABLE` 的细节，闭合对象。",
      "required": [
        "request_id",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "$ref": "#/$defs/ChatLlmUnavailableReason"
        }
      }
    },
    "ChatLlmUnavailableError": {
      "description": "模型不可用（O7～O10）；`details.reason` 区分上游故障、流中断、链路超时与鉴权失败。",
      "allOf": [
        {
          "$ref": "#/$defs/Error"
        },
        {
          "type": "object",
          "required": [
            "code",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "const": "LLM_UNAVAILABLE"
            },
            "details": {
              "$ref": "#/$defs/ChatLlmUnavailableDetails"
            }
          }
        }
      ]
    },
    "ChatLlmUnavailableReason": {
      "type": "string",
      "description": "问答 `LLM_UNAVAILABLE` 的原因闭集（Q5）：`timeout` 当且仅当链路时限到期；其余首字前失败（含两路首字超时）\n一律 `upstream`；出字后供应商流中断为 `stream_interrupted`；供应商鉴权失败为 `auth`。\n",
      "enum": [
        "upstream",
        "stream_interrupted",
        "timeout",
        "auth"
      ]
    },
    "ChatMetaEvent": {
      "type": "object",
      "description": "检索完成、生成开始前的第一条事件，恒为一条（`specs/grounded-qa.md` Q2）。\n`status = not_covered` 当且仅当检索阶段判定拒答，此时 `retrieved = 0`，后续不再有 delta，直接发 done。\n`status = answered` 表示进入生成（允许引用集合 A 非空，`retrieved ≥ 1`），不是承诺：终态仍可能是 `not_covered` 或 `error`。\n",
      "required": [
        "event",
        "status",
        "retrieved",
        "graph_version",
        "request_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_covered"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "retrieved": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "answered"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "retrieved": {
                "minimum": 1
              }
            }
          }
        }
      ],
      "properties": {
        "event": {
          "type": "string",
          "const": "meta"
        },
        "status": {
          "$ref": "#/$defs/ChatStatus"
        },
        "retrieved": {
          "type": "integer",
          "minimum": 0,
          "description": "允许引用集合 A 的大小（进入生成上下文的编号文本块数），供前端显示「已检索 N 段」"
        },
        "graph_version": {
          "type": "integer",
          "minimum": 1,
          "description": "本请求绑定的发布版本号（P2 读一次发布指针）；请求途中发布或回滚不影响本请求（Q9）"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "description": "P2 生成的请求 ID（ULID），与日志、`model_calls` 及错误 `details.request_id` 对应"
        }
      }
    },
    "ChatNotCovered": {
      "type": "object",
      "description": "资料未覆盖。**引用必须为空数组**，并给出机读原因。\n这是 200 响应的领域状态，不是 HTTP 错误（ADR-003）。\n",
      "required": [
        "status",
        "answer",
        "citations",
        "reason",
        "graph_version",
        "request_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "not_covered"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "description": "面向用户的可解释说明，不得包含无依据的结论性内容"
        },
        "citations": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/Citation"
          }
        },
        "reason": {
          "$ref": "#/$defs/NotCoveredReason"
        },
        "related_kp_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "graph_version": {
          "type": "integer",
          "minimum": 1,
          "description": "本请求绑定的发布版本号（P2 读一次发布指针）；请求途中发布或回滚不影响本请求（Q9）"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "description": "P2 生成的请求 ID（ULID），与日志、`model_calls` 及错误 `details.request_id` 对应"
        }
      }
    },
    "ChatResponse": {
      "description": "按 `status` 分支的问答响应。分支存在的原因见 `src/contracts/README.md` §5.4：\n「answered 至少一条引用」若只写在描述里，生成的客户端会把\n`{\"status\":\"answered\",\"answer\":\"结论\",\"citations\":[]}` 当成合格响应。\n",
      "oneOf": [
        {
          "$ref": "#/$defs/ChatAnswered"
        },
        {
          "$ref": "#/$defs/ChatNotCovered"
        }
      ],
      "discriminator": {
        "propertyName": "status",
        "mapping": {
          "answered": "#/components/schemas/ChatAnswered",
          "not_covered": "#/components/schemas/ChatNotCovered"
        }
      }
    },
    "ChatServiceError": {
      "description": "预算拒绝（O11）、调用记录预写失败（O12）或未预期异常（O13）；不带 `reason`。",
      "allOf": [
        {
          "$ref": "#/$defs/Error"
        },
        {
          "type": "object",
          "required": [
            "code",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "BUDGET_EXCEEDED",
                "STORAGE_UNAVAILABLE",
                "INTERNAL_ERROR"
              ]
            },
            "details": {
              "$ref": "#/$defs/ChatErrorDetails"
            }
          }
        }
      ]
    },
    "ChatStatus": {
      "type": "string",
      "description": "问答的两种终态。结构差异由 `ChatAnswered` / `ChatNotCovered` 两个\n独立 schema 表达，不靠本枚举的描述文字约束（ADR-003）。\n",
      "enum": [
        "answered",
        "not_covered"
      ]
    },
    "Citation": {
      "type": "object",
      "description": "引用编号与原文定位；生成后经引用校验，无效编号被剔除。\n与 `SourceRef` 同样要求可定位：`page` 与 `section_path` 至少给出一个。\n",
      "required": [
        "index",
        "chunk_id",
        "document_id",
        "text"
      ],
      "anyOf": [
        {
          "required": [
            "page"
          ]
        },
        {
          "required": [
            "section_path"
          ]
        }
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1,
          "description": "回答正文中标注的编号"
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "section_path": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "description": "面向用户的可读说明"
        },
        "details": {
          "type": "object",
          "description": "结构化补充，例如 `CYCLE_DETECTED` 的 `cycle` 节点链路",
          "additionalProperties": true
        }
      }
    },
    "ErrorCode": {
      "type": "string",
      "description": "错误码全集，逐条说明见 `errors.v1.md`",
      "enum": [
        "UNAUTHENTICATED",
        "COURSE_FORBIDDEN",
        "ROLE_FORBIDDEN",
        "NOT_FOUND",
        "GRAPH_NOT_PUBLISHED",
        "UNSUPPORTED_FORMAT",
        "FILE_TOO_LARGE",
        "VALIDATION_ERROR",
        "CYCLE_DETECTED",
        "DANGLING_ENDPOINT",
        "DUPLICATE_RELATION",
        "NODE_LOCKED",
        "TASK_NOT_CANCELLABLE",
        "PUBLISH_BLOCKED",
        "RATE_LIMITED",
        "LLM_UNAVAILABLE",
        "DOCUMENT_UNREADABLE",
        "EXTRACTION_INCOMPLETE",
        "STORAGE_UNAVAILABLE",
        "INTERNAL_ERROR",
        "TASK_ATTEMPTS_EXHAUSTED",
        "PUBLISH_IN_PROGRESS",
        "COURSE_BUSY",
        "BUDGET_EXCEEDED",
        "DOCUMENT_NOT_DELETABLE",
        "REVISION_CONFLICT"
      ]
    },
    "NotCoveredReason": {
      "type": "string",
      "description": "机读的拒答原因，闭集。前端按此分支给出不同引导文案，\n不解析 `answer` 的自然语言（AGENTS.md §4「可机读的资料未覆盖状态」）。\n前两者在检索阶段判定、不调用生成；后两者调用了生成（`specs/grounded-qa.md` Q4、Q5）。\n",
      "enum": [
        "no_retrieval_hit",
        "below_similarity_threshold",
        "insufficient_evidence",
        "all_citations_invalidated"
      ]
    }
  }
}
