{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartsketch.local/contracts/v1/TaskEvent.schema.json",
  "title": "TaskEvent",
  "$ref": "#/$defs/TaskEvent",
  "$defs": {
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "description": "面向用户的可读说明"
        },
        "details": {
          "type": "object",
          "description": "结构化补充，例如 `CYCLE_DETECTED` 的 `cycle` 节点链路",
          "additionalProperties": true
        }
      }
    },
    "ErrorCode": {
      "type": "string",
      "description": "错误码全集，逐条说明见 `errors.v1.md`",
      "enum": [
        "UNAUTHENTICATED",
        "COURSE_FORBIDDEN",
        "ROLE_FORBIDDEN",
        "NOT_FOUND",
        "GRAPH_NOT_PUBLISHED",
        "UNSUPPORTED_FORMAT",
        "FILE_TOO_LARGE",
        "VALIDATION_ERROR",
        "CYCLE_DETECTED",
        "DANGLING_ENDPOINT",
        "DUPLICATE_RELATION",
        "NODE_LOCKED",
        "TASK_NOT_CANCELLABLE",
        "PUBLISH_BLOCKED",
        "RATE_LIMITED",
        "LLM_UNAVAILABLE",
        "DOCUMENT_UNREADABLE",
        "EXTRACTION_INCOMPLETE",
        "STORAGE_UNAVAILABLE",
        "INTERNAL_ERROR",
        "TASK_ATTEMPTS_EXHAUSTED",
        "PUBLISH_IN_PROGRESS",
        "COURSE_BUSY",
        "BUDGET_EXCEEDED"
      ]
    },
    "FixedStageProgress": {
      "description": "`specs/task-processing.md` §1 的固定进度：`queued` 为 0，`awaiting_review` 为 0.95\n（`completed` 为 1，由对应分支的 `const` 表达）。只约束取值，代码生成器会忽略，\n运行时由 C08 状态迁移纯函数保证。\n",
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "queued"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "progress": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "awaiting_review"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "progress": {
                "const": 0.95
              }
            }
          }
        }
      ]
    },
    "TaskCancelledEvent": {
      "type": "object",
      "description": "`event: cancelled`。任务进入或已处于 `cancelled`；取消必然先置标志，故 `cancel_requested` 恒为 true。发送后关流。",
      "required": [
        "task_id",
        "stage",
        "progress",
        "cancel_requested"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "const": "cancelled"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cancel_requested": {
          "type": "boolean",
          "const": true
        },
        "counts": {
          "$ref": "#/$defs/TaskCounts"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "TaskCounts": {
      "type": "object",
      "properties": {
        "chunks_done": {
          "type": "integer",
          "minimum": 0
        },
        "chunks_total": {
          "type": "integer",
          "minimum": 0
        },
        "kp_count": {
          "type": "integer",
          "minimum": 0
        },
        "relation_count": {
          "type": "integer",
          "minimum": 0
        },
        "chunks_failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "TaskDoneEvent": {
      "type": "object",
      "description": "`event: done`。只会作为「任务已 `completed` 后才建立的连接」的首条快照出现，随后关流；\n处理期的连接以 `awaiting_review` 收尾，永远收不到它（`specs/task-processing.md` §7）。\n",
      "required": [
        "task_id",
        "stage",
        "progress"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "const": "completed"
        },
        "progress": {
          "type": "number",
          "const": 1
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/TaskCounts"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "TaskErrorEvent": {
      "type": "object",
      "description": "`event: error`。任务进入或已处于 `failed`；`error` 必填且不为 null。发送后关流。",
      "required": [
        "task_id",
        "stage",
        "progress",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "const": "failed"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "error": {
          "$ref": "#/$defs/Error"
        },
        "cancel_requested": {
          "type": "boolean",
          "description": "取消标志已置、到检查点前失败时保持 true（TASK-7）。"
        },
        "counts": {
          "$ref": "#/$defs/TaskCounts"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "TaskEvent": {
      "description": "单条任务 SSE 事件的 data 载荷。**每种事件有独立 schema 且 required 非空**，`{}` 不合法；\n按 `stage` 判别，与 `event:` 行一一对应（stage / done / error / cancelled）。\n事件名、顺序、关流与重连语义见 `events.v1.md` §2、§4。\n",
      "oneOf": [
        {
          "$ref": "#/$defs/TaskStageEvent"
        },
        {
          "$ref": "#/$defs/TaskDoneEvent"
        },
        {
          "$ref": "#/$defs/TaskErrorEvent"
        },
        {
          "$ref": "#/$defs/TaskCancelledEvent"
        }
      ],
      "discriminator": {
        "propertyName": "stage",
        "mapping": {
          "queued": "#/components/schemas/TaskStageEvent",
          "parsing": "#/components/schemas/TaskStageEvent",
          "extracting": "#/components/schemas/TaskStageEvent",
          "merging": "#/components/schemas/TaskStageEvent",
          "persisting": "#/components/schemas/TaskStageEvent",
          "awaiting_review": "#/components/schemas/TaskStageEvent",
          "completed": "#/components/schemas/TaskDoneEvent",
          "failed": "#/components/schemas/TaskErrorEvent",
          "cancelled": "#/components/schemas/TaskCancelledEvent"
        }
      }
    },
    "TaskStageEvent": {
      "type": "object",
      "description": "`event: stage`。建连快照（非终态）、进入新阶段、阶段内进度变化、`cancel_requested` 由 false 变 true 时推送。\n`stage = awaiting_review`（`progress = 0.95`）是处理期连接的结束事件，推送后服务端关流。\n",
      "required": [
        "task_id",
        "stage",
        "progress",
        "cancel_requested"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/FixedStageProgress"
        }
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "enum": [
            "queued",
            "parsing",
            "extracting",
            "merging",
            "persisting",
            "awaiting_review"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cancel_requested": {
          "type": "boolean",
          "description": "已收到取消请求但 worker 尚未到达块边界（协作式取消）。这是**标志位不是状态**：\n取消未生效前 `stage` 仍是当前阶段，前端据此显示「取消中」。\n"
        },
        "counts": {
          "$ref": "#/$defs/TaskCounts"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
