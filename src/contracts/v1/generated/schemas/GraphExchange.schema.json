{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartsketch.local/contracts/v1/GraphExchange.schema.json",
  "title": "GraphExchange",
  "$ref": "#/$defs/GraphExchange",
  "$defs": {
    "Chapter": {
      "type": "object",
      "required": [
        "id",
        "title",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "GraphExchange": {
      "type": "object",
      "description": "图谱交换格式（M0-04c）。同时用于 API 响应、前端 G6 适配层输入与图谱导入导出。\n`nodes` 与 `edges` 已按 `course_id` 隔离，调用方不得跨课程合并。\n",
      "required": [
        "format_version",
        "course_id",
        "graph_version",
        "generated_at",
        "nodes",
        "edges"
      ],
      "properties": {
        "format_version": {
          "type": "string",
          "const": "1.0"
        },
        "course_id": {
          "type": "string"
        },
        "graph_version": {
          "type": [
            "integer",
            "null"
          ],
          "description": "已发布版本号；草稿为 null"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Chapter"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KnowledgePoint"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        },
        "stats": {
          "$ref": "#/$defs/GraphStats"
        }
      }
    },
    "GraphStats": {
      "type": "object",
      "description": "图谱质量体检，供教师发布前判断可用性",
      "required": [
        "node_count",
        "edge_count"
      ],
      "properties": {
        "node_count": {
          "type": "integer"
        },
        "edge_count": {
          "type": "integer"
        },
        "edges_by_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "isolated_count": {
          "type": "integer",
          "description": "无任何关系的孤立知识点数"
        },
        "low_confidence_count": {
          "type": "integer"
        },
        "max_level": {
          "type": "integer"
        },
        "chapter_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "含至少一个知识点的章节占比"
        }
      }
    },
    "KnowledgePoint": {
      "type": "object",
      "required": [
        "id",
        "course_id",
        "name",
        "type",
        "definition",
        "level",
        "confidence",
        "status",
        "source",
        "locked",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "course_id": {
          "type": "string"
        },
        "chapter_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "$ref": "#/$defs/KnowledgePointType"
        },
        "definition": {
          "type": "string"
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "difficulty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "description": "前置关系图中的最长前置路径长度，用于层次布局与路径排序"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "$ref": "#/$defs/KnowledgePointStatus"
        },
        "source": {
          "$ref": "#/$defs/NodeSource"
        },
        "locked": {
          "type": "boolean",
          "description": "true 时不被后续自动抽取/融合流程覆盖"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "节点级乐观并发修订号；不同于课程 draft_revision。"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        }
      }
    },
    "KnowledgePointStatus": {
      "type": "string",
      "description": "审核状态；low_confidence 项进入审核队列",
      "enum": [
        "draft",
        "low_confidence",
        "approved",
        "rejected"
      ]
    },
    "KnowledgePointType": {
      "type": "string",
      "description": "对应 S2 表 6.3 的五类知识点",
      "enum": [
        "concept",
        "theorem",
        "formula",
        "method",
        "example"
      ]
    },
    "NodeSource": {
      "type": "string",
      "enum": [
        "ai",
        "manual"
      ]
    },
    "Relation": {
      "oneOf": [
        {
          "$ref": "#/$defs/RelationStandard"
        },
        {
          "$ref": "#/$defs/RelationDowngraded"
        }
      ]
    },
    "RelationDowngraded": {
      "type": "object",
      "required": [
        "id",
        "course_id",
        "type",
        "from_id",
        "to_id",
        "confidence",
        "status",
        "source",
        "source_refs",
        "downgraded_from_type",
        "downgrade_cycle"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "course_id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "RELATED_TO"
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string",
          "const": "low_confidence"
        },
        "source": {
          "type": "string",
          "const": "ai"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "downgraded_from_type": {
          "type": "string",
          "const": "PREREQUISITE",
          "description": "仅自动成环降级时返回；原关系类型。"
        },
        "downgrade_cycle": {
          "type": "array",
          "minItems": 2,
          "x-closed-cycle": true,
          "description": "仅自动成环降级时返回；触发降级的知识点 ID 环路。",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "RelationStandard": {
      "type": "object",
      "required": [
        "id",
        "course_id",
        "type",
        "from_id",
        "to_id",
        "confidence",
        "status",
        "source",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "course_id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/RelationType"
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "$ref": "#/$defs/KnowledgePointStatus"
        },
        "source": {
          "$ref": "#/$defs/NodeSource"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        }
      }
    },
    "RelationType": {
      "type": "string",
      "description": "ADR-008 命名基线，四类教学关系，不得引入别名",
      "enum": [
        "CONTAINS",
        "PREREQUISITE",
        "RELATED_TO",
        "EXAMPLE_OF"
      ]
    },
    "SourceRef": {
      "type": "object",
      "description": "证据链的最小单元。必须能把读者带回原文的具体位置：\n`page`（正整数）与 `section_path`（非空）**至少给出一个**（ADR-003）。\n该规则写成 anyOf 而不是只写在描述里——描述文字不构成 schema 约束，\n生成的客户端与结构校验不会因此拦住无法定位的来源。\n",
      "required": [
        "chunk_id",
        "document_id"
      ],
      "anyOf": [
        {
          "required": [
            "page"
          ]
        },
        {
          "required": [
            "section_path"
          ]
        }
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "section_path": {
          "type": "string",
          "minLength": 1,
          "description": "章节路径，如「第3章 > 3.1 栈」。无页码的来源（MD/TXT）靠它定位"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "description": "页码，从 1 起。无分页的来源不带此字段（不是 null）"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "原文片段，供前端高亮"
        }
      }
    }
  }
}
